# Supabase
# Vercel blocks saving env vars named with a NEXT_PUBLIC_ prefix in some
# cases (it treats "PUBLIC" as a signal a secret is being exposed) — this
# can hit both the project URL and anon key, even though both are meant to
# be public (protection comes from RLS, not secrecy). If Vercel refuses
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY, set the plain
# SUPABASE_URL / SUPABASE_ANON_KEY versions instead — next.config.ts
# re-exposes them under the NEXT_PUBLIC_ names the client code expects.
# Locally, either name works.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
# Server-side only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (server-side only)
OPENAI_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
