# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# The anon key is meant to be public (protection comes from RLS, not
# secrecy), but some platforms (e.g. Vercel) block saving a NEXT_PUBLIC_
# variable that looks like a JWT. If that happens, set SUPABASE_ANON_KEY
# instead (no prefix) — next.config.ts re-exposes it under the
# NEXT_PUBLIC_ name the client code expects. Locally, either name works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
# Server-side only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (server-side only)
OPENAI_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
